DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_only_key
# Add public-data and walking-route API keys only to your local .env
AED_API_KEY=
TMAP_API_KEY=
# Local-only rate-limit store. Production must use a configured shared store.
APP_ENV=development
RATE_LIMIT_STORE=memory
RATE_LIMIT_TRUSTED_PROXY=peer
RATE_LIMIT_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
